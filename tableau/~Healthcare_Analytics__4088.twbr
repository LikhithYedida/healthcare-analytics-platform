    <worksheet name='OPS_CHT_Encounter_Mix'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontalignment='1' fontcolor='#233a34' fontname='Arial' fontsize='12'>Encounter Mix by Facility</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='mart_hospital_operations (healthcare_analytics.gold.mart_hospital_operations) (gold)' name='federated.0rk52rl1pmoe1n1cl7hd61s20d6q' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='p_Reporting_Window' datatype='string' name='[Parameter 0280968702808064]' param-domain-type='list' role='measure' type='nominal' value='&quot;Current Rolling 12M&quot;'>
              <calculation class='tableau' formula='&quot;Current Rolling 12M&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0rk52rl1pmoe1n1cl7hd61s20d6q'>
            <column caption='Reporting Period Filter' datatype='boolean' name='[Calculation_0280968789573655]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 0280968702808064]&#13;&#10;&#13;&#10;WHEN &quot;Current Rolling 12M&quot; THEN&#13;&#10;    DATE([month_start]) &gt;= #2025-09-01#&#13;&#10;    AND DATE([month_start]) &lt; #2026-09-01#&#13;&#10;&#13;&#10;WHEN &quot;Prior Rolling 12M&quot; THEN&#13;&#10;    DATE([month_start]) &gt;= #2024-09-01#&#13;&#10;    AND DATE([month_start]) &lt; #2025-09-01#&#13;&#10;&#13;&#10;WHEN &quot;All Available&quot; THEN&#13;&#10;    TRUE&#13;&#10;&#13;&#10;ELSE TRUE&#13;&#10;END' />
            </column>
            <column caption='Ambulatory Encounters' datatype='integer' name='[ambulatory_encounters]' role='measure' type='quantitative' />
            <column caption='Emergency Encounters' datatype='integer' name='[emergency_encounters]' role='measure' type='quantitative' />
            <column caption='Inpatient Encounters' datatype='integer' name='[inpatient_encounters]' role='measure' type='quantitative' />
            <column caption='Month Start' datatype='date' name='[month_start]' role='dimension' type='ordinal' />
            <column-instance column='[Calculation_0280968789573655]' derivation='None' name='[none:Calculation_0280968789573655:nk]' pivot='key' type='nominal' />
