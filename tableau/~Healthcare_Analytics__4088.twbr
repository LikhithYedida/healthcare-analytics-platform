              <aliases>
                <alias key='&quot;NO_INSURANCE&quot;' value='No Insurance' />
              </aliases>
            </column>
            <column caption='Total Claim Cost' datatype='real' name='[total_claim_cost]' role='measure' type='quantitative' />
            <column-instance column='[Calculation_0280968754126863]' derivation='User' name='[usr:Calculation_0280968754126863:qk]' pivot='key' type='quantitative' />
