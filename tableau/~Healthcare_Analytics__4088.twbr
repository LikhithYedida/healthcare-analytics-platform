      <column caption='Reporting Period Filter' datatype='boolean' name='[Calculation_0280968716652551]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 0280968702808064]&#13;&#10;&#13;&#10;WHEN &quot;Current Rolling 12M&quot; THEN&#13;&#10;    [month_start] &gt;= DATE(&quot;2025-09-01&quot;)&#13;&#10;    AND [month_start] &lt;= DATE(&quot;2026-08-01&quot;)&#13;&#10;&#13;&#10;WHEN &quot;Prior Rolling 12M&quot; THEN&#13;&#10;    [month_start] &gt;= DATE(&quot;2024-09-01&quot;)&#13;&#10;    AND [month_start] &lt;= DATE(&quot;2025-08-01&quot;)&#13;&#10;&#13;&#10;END' />
      </column>
