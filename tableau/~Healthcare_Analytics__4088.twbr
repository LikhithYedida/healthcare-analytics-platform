            <column-instance column='[Calculation_0280968709849092]' derivation='None' name='[none:Calculation_0280968709849092:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_0280968710029317]' derivation='None' name='[none:Calculation_0280968710029317:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_0280968710094854]' derivation='None' name='[none:Calculation_0280968710094854:nk]' pivot='key' type='nominal' />
            <column-instance column='[kpi_name]' derivation='None' name='[none:kpi_name:nk]' pivot='key' type='nominal' />
