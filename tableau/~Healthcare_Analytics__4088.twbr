    <worksheet name='OPS_KPI_Avg_Duration'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontalignment='1' fontcolor='#000000' fontname='Arial' fontsize='12'>Avg Encounter Duration</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='mart_hospital_operations (healthcare_analytics.gold.mart_hospital_operations) (gold)' name='federated.0rk52rl1pmoe1n1cl7hd61s20d6q' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='p_Reporting_Window' datatype='string' name='[Parameter 0280968702808064]' param-domain-type='list' role='measure' type='nominal' value='&quot;Current Rolling 12M&quot;'>
              <calculation class='tableau' formula='&quot;Current Rolling 12M&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0rk52rl1pmoe1n1cl7hd61s20d6q'>
            <column caption='SUM([Avg Encounter Duration Hours] * [Encounter Count]) / SUM...' datatype='real' name='[Calculation_0280968780890131]' role='measure' type='quantitative' user:unnamed='OPS_KPI_Avg_Duration'>
              <calculation class='tableau' formula='SUM([avg_encounter_duration_hours] * [encounter_count])&#13;&#10;/&#13;&#10;SUM([encounter_count])' />
            </column>
            <column caption='Reporting Period Filter' datatype='boolean' name='[Calculation_0280968789573655]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 0280968702808064]&#13;&#10;&#13;&#10;WHEN &quot;Current Rolling 12M&quot; THEN&#13;&#10;    DATE([month_start]) &gt;= #2025-09-01#&#13;&#10;    AND DATE([month_start]) &lt; #2026-09-01#&#13;&#10;&#13;&#10;WHEN &quot;Prior Rolling 12M&quot; THEN&#13;&#10;    DATE([month_start]) &gt;= #2024-09-01#&#13;&#10;    AND DATE([month_start]) &lt; #2025-09-01#&#13;&#10;&#13;&#10;WHEN &quot;All Available&quot; THEN&#13;&#10;    TRUE&#13;&#10;&#13;&#10;ELSE TRUE&#13;&#10;END' />
            </column>
            <column caption='Avg Encounter Duration Hours' datatype='real' name='[avg_encounter_duration_hours]' role='measure' type='quantitative' />
            <column caption='Encounter Count' datatype='integer' name='[encounter_count]' role='measure' type='quantitative' />
            <column caption='Month Start' datatype='date' name='[month_start]' role='dimension' type='ordinal' />
            <column-instance column='[Calculation_0280968789573655]' derivation='None' name='[none:Calculation_0280968789573655:nk]' pivot='key' type='nominal' />
            <column-instance column='[organization_name]' derivation='None' name='[none:organization_name:nk]' pivot='key' type='nominal' />
            <column caption='Organization Name' datatype='string' name='[organization_name]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_0280968780890131]' derivation='User' name='[usr:Calculation_0280968780890131:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <slices>
            <column>[federated.0rk52rl1pmoe1n1cl7hd61s20d6q].[none:Calculation_0280968789573655:nk]</column>
            <column>[federated.0rk52rl1pmoe1n1cl7hd61s20d6q].[none:organization_name:nk]</column>
          </slices>
          <aggregation value='true' />
        </view>
