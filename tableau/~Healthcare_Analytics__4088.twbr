            <column-instance column='[ambulatory_encounters]' derivation='Sum' name='[sum:ambulatory_encounters:qk]' pivot='key' type='quantitative' />
            <column-instance column='[emergency_encounters]' derivation='Sum' name='[sum:emergency_encounters:qk]' pivot='key' type='quantitative' />
            <column-instance column='[inpatient_encounters]' derivation='Sum' name='[sum:inpatient_encounters:qk]' pivot='key' type='quantitative' />
