              </aliases>
            </column>
            <column-instance column='[total_claim_cost]' derivation='Sum' name='[sum:total_claim_cost:qk]' pivot='key' type='quantitative' />
            <column caption='Total Claim Cost' datatype='real' name='[total_claim_cost]' role='measure' type='quantitative' />
          </datasource-dependencies>
          <slices>
            <column>[federated.1ghdjs607npq5a1byeo491ds8nkz].[none:Calculation_0280968753156110:nk]</column>
            <column>[federated.1ghdjs607npq5a1byeo491ds8nkz].[none:payer_name:nk]</column>
