      <aliases enabled='yes' />
      <column caption='Outcome Status' datatype='string' name='[Calculation_0280968791941144]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF ISNULL([death_date]) THEN&#13;&#10;    &quot;Living&quot;&#13;&#10;ELSE&#13;&#10;    &quot;Deceased&quot;&#13;&#10;END' />
      </column>
      <column caption='Patient Age' datatype='integer' name='[Calculation_0280968792047641]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='DATEDIFF(&#13;&#10;    &apos;year&apos;,&#13;&#10;    [birth_date],&#13;&#10;    IF ISNULL([death_date]) THEN #2026-08-31#&#13;&#10;    ELSE [death_date]&#13;&#10;    END&#13;&#10;)' />
      </column>
      <column caption='Age Limit' datatype='string' name='[Calculation_0280968792117274]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_0280968792047641] &lt; 18 THEN &quot;0-17&quot;&#13;&#10;ELSEIF [Calculation_0280968792047641] &lt; 35 THEN &quot;18-34&quot;&#13;&#10;ELSEIF [Calculation_0280968792047641] &lt; 50 THEN &quot;35-49&quot;&#13;&#10;ELSEIF [Calculation_0280968792047641] &lt; 65 THEN &quot;50-64&quot;&#13;&#10;ELSEIF [Calculation_0280968792047641] &lt; 80 THEN &quot;65-79&quot;&#13;&#10;ELSE &quot;80+&quot;&#13;&#10;END' />
      </column>
      <column caption='OUT Deceased Patients' datatype='integer' name='[Calculation_0280968793030684]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(&#13;&#10;    IF NOT ISNULL([death_date]) THEN&#13;&#10;        [patient_id]&#13;&#10;    END&#13;&#10;)' />
      </column>
      <column caption='Mortality Rate %' datatype='real' default-format='p0.0%' name='[Calculation_0280968796225570]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(&#13;&#10;    IF [Calculation_0280968791941144] = &quot;Deceased&quot;&#13;&#10;    THEN [patient_id]&#13;&#10;    END&#13;&#10;)&#13;&#10;/&#13;&#10;COUNTD([patient_id])' />
      </column>
