      <table>
        <view>
          <datasources>
            <datasource caption='mart_claims_cost (healthcare_analytics.gold.mart_claims_cost) (gold)' name='federated.1ghdjs607npq5a1byeo491ds8nkz' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='p_Reporting_Window' datatype='string' name='[Parameter 0280968702808064]' param-domain-type='list' role='measure' type='nominal' value='&quot;Current Rolling 12M&quot;'>
              <calculation class='tableau' formula='&quot;Current Rolling 12M&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1ghdjs607npq5a1byeo491ds8nkz'>
            <column caption='Reporting Period Filter' datatype='boolean' name='[Calculation_0280968753156110]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 0280968702808064]&#13;&#10;&#13;&#10;WHEN &quot;Current Rolling 12M&quot; THEN&#13;&#10;    DATE([month_start]) &gt;= #2025-09-01#&#13;&#10;    AND DATE([month_start]) &lt; #2026-09-01#&#13;&#10;&#13;&#10;WHEN &quot;Prior Rolling 12M&quot; THEN&#13;&#10;    DATE([month_start]) &gt;= #2024-09-01#&#13;&#10;    AND DATE([month_start]) &lt; #2025-09-01#&#13;&#10;&#13;&#10;WHEN &quot;All Available&quot; THEN&#13;&#10;    TRUE&#13;&#10;&#13;&#10;ELSE&#13;&#10;    TRUE&#13;&#10;&#13;&#10;END' />
            </column>
            <column-instance column='[month_start]' derivation='Month' name='[mn:month_start:ok]' pivot='key' type='ordinal' />
            <column caption='Month Start' datatype='date' name='[month_start]' role='dimension' type='ordinal' />
            <column-instance column='[Calculation_0280968753156110]' derivation='None' name='[none:Calculation_0280968753156110:nk]' pivot='key' type='nominal' />
            <column-instance column='[payer_name]' derivation='None' name='[none:payer_name:nk]' pivot='key' type='nominal' />
            <column caption='Payer Name' datatype='string' name='[payer_name]' role='dimension' type='nominal'>
              <aliases>
