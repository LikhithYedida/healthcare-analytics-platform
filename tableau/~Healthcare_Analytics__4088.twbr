      <aliases enabled='yes' />
      <column caption='Selected KPI Display' datatype='string' name='[Calculation_0280968703741954]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 0280968702808064]&#13;&#10;&#13;&#10;WHEN &quot;Current Rolling 12M&quot;&#13;&#10;THEN [current_display]&#13;&#10;&#13;&#10;WHEN &quot;Prior Rolling 12M&quot;&#13;&#10;THEN [prior_display]&#13;&#10;&#13;&#10;END' />
      </column>
      <column caption='Selected Comparison Text' datatype='string' name='[Calculation_0280968703823875]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 0280968702808064] = &quot;Current Rolling 12M&quot; THEN&#13;&#10;    [comparison_text]&#13;&#10;ELSE&#13;&#10;    &quot;Baseline period&quot;&#13;&#10;END' />
      </column>
      <column caption='CMP Favorable' datatype='string' name='[Calculation_0280968709849092]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 0280968702808064] = &quot;Current Rolling 12M&quot;&#13;&#10;AND [performance_signal] = &quot;FAVORABLE&quot;&#13;&#10;THEN [comparison_text]&#13;&#10;END' />
      </column>
      <column caption='CMP Unfavorable' datatype='string' name='[Calculation_0280968710029317]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 0280968702808064] = &quot;Current Rolling 12M&quot;&#13;&#10;AND [performance_signal] = &quot;UNFAVORABLE&quot;&#13;&#10;THEN [comparison_text]&#13;&#10;END' />
      </column>
      <column caption='CMP Neutral' datatype='string' name='[Calculation_0280968710094854]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 0280968702808064] = &quot;Prior Rolling 12M&quot; THEN&#13;&#10;    &quot;Baseline period&quot;&#13;&#10;&#13;&#10;ELSEIF [performance_signal] = &quot;NEUTRAL&quot; THEN&#13;&#10;    [comparison_text]&#13;&#10;END' />
      </column>
