      <column caption='Reporting Period Filter' datatype='boolean' name='[Calculation_0280968729157640]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 0280968702808064] = &quot;Current Rolling 12M&quot; THEN&#13;&#10;&#13;&#10;    [month_start] &gt;= #2025-09-01#&#13;&#10;    AND [month_start] &lt;= #2026-08-01#&#13;&#10;&#13;&#10;ELSEIF [Parameters].[Parameter 0280968702808064] = &quot;Prior Rolling 12M&quot; THEN&#13;&#10;&#13;&#10;    [month_start] &gt;= #2024-09-01#&#13;&#10;    AND [month_start] &lt;= #2025-08-01#&#13;&#10;&#13;&#10;ELSE&#13;&#10;    TRUE&#13;&#10;END' />
      </column>
