      <aliases enabled='yes' />
      <column caption='OPS Avg Cost per Encounter' datatype='real' name='[Calculation_0280968784355349]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([total_claim_cost])&#13;&#10;/&#13;&#10;SUM([encounter_count])' />
      </column>
      <column caption='OPS Avg Encounter Duration' datatype='real' name='[Calculation_0280968784441366]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(&#13;&#10;    [avg_encounter_duration_hours] * [encounter_count]&#13;&#10;)&#13;&#10;/&#13;&#10;SUM([encounter_count])' />
      </column>
      <column caption='Reporting Period Filter' datatype='boolean' name='[Calculation_0280968789573655]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 0280968702808064]&#13;&#10;&#13;&#10;WHEN &quot;Current Rolling 12M&quot; THEN&#13;&#10;    DATE([month_start]) &gt;= #2025-09-01#&#13;&#10;    AND DATE([month_start]) &lt; #2026-09-01#&#13;&#10;&#13;&#10;WHEN &quot;Prior Rolling 12M&quot; THEN&#13;&#10;    DATE([month_start]) &gt;= #2024-09-01#&#13;&#10;    AND DATE([month_start]) &lt; #2025-09-01#&#13;&#10;&#13;&#10;WHEN &quot;All Available&quot; THEN&#13;&#10;    TRUE&#13;&#10;&#13;&#10;ELSE TRUE&#13;&#10;END' />
      </column>
