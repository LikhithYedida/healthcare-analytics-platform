    <worksheet name='OPS_CHT_Facility_Efficiency'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontalignment='1' fontcolor='#233a34' fontname='Arial' fontsize='12'>Facility Efficiency Matrix</run>
