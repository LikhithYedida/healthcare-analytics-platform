{
  "name": "ds_synthea_source",
  "properties": {
    "description": "Sanitized dataset contract for synthetic Synthea CSV source files.",
    "linkedServiceName": {
      "referenceName": "ls_source_storage",
      "type": "LinkedServiceReference"
    },
    "parameters": {
      "folder_path": {
        "type": "string"
      }
    },
    "type": "DelimitedText",
    "typeProperties": {
      "location": {
        "type": "AzureBlobFSLocation",
        "folderPath": "@dataset().folder_path",
        "fileSystem": "<SOURCE_CONTAINER>"
      },
      "columnDelimiter": ",",
      "escapeChar": "\\",
      "firstRowAsHeader": true,
      "quoteChar": "\""
    },
    "schema": []
  }
}